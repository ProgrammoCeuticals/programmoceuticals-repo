# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (used by Prisma)
DATABASE_URL="postgresql://pharmintern:changeme@localhost:5432/pharmintern_dev?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
# Full Redis URL alternative (used by BullMQ)
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-64-byte-random-secret"
JWT_ACCESS_EXPIRY="15m"
# Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET="replace-with-different-64-byte-random-secret"
JWT_REFRESH_EXPIRY="7d"

# ─── API ─────────────────────────────────────────────────────────────────────
PORT="3001"
NODE_ENV="development"
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# ─── Email ───────────────────────────────────────────────────────────────────
# Provider: "console" (dev) | "smtp" | "sendgrid" | "ses"
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@pharmintern.ng"
EMAIL_FROM_NAME="PharmIntern NG"
# SMTP settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=""

# ─── File Storage ─────────────────────────────────────────────────────────────
# Provider: "local" (dev only) | "s3"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
# S3-compatible settings (used when STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
# Signed URL TTL in seconds (default 15 minutes)
STORAGE_SIGNED_URL_TTL="900"

# ─── Web App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# ─── Admin ───────────────────────────────────────────────────────────────────
# Bootstrap admin account (used only in seed; never in production logic)
SEED_ADMIN_EMAIL="admin@pharmintern.ng"
SEED_ADMIN_PASSWORD="replace-before-seeding"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_GLOBAL="900000"
THROTTLE_LIMIT_GLOBAL="100"

# ─── Idempotency ──────────────────────────────────────────────────────────────
IDEMPOTENCY_KEY_TTL_SECONDS="86400"

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to "true" to enable malware scanning (requires a configured scanner)
ENABLE_MALWARE_SCAN="false"
# Offer expiry worker cron (every 5 minutes)
OFFER_EXPIRY_CRON="*/5 * * * *"
