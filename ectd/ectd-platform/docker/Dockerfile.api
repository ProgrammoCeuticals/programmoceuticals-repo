# ── ProgrammoCeuticals eCTD API — Production Dockerfile ────────────────────
# Multi-stage build — spec §53

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g pnpm@9.15.4 --quiet

# ── Dependencies stage ───────────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ectd-domain/package.json ./packages/ectd-domain/
COPY packages/ectd-documents/package.json ./packages/ectd-documents/
COPY packages/ectd-lifecycle/package.json ./packages/ectd-lifecycle/
COPY packages/ectd-publishing/package.json ./packages/ectd-publishing/
COPY packages/ectd-standards/package.json ./packages/ectd-standards/
COPY packages/ectd-storage/package.json ./packages/ectd-storage/
COPY packages/ectd-validation/package.json ./packages/ectd-validation/
COPY packages/ectd-xml/package.json ./packages/ectd-xml/
RUN pnpm install --frozen-lockfile --prod=false

# ── Build stage ──────────────────────────────────────────────────────────────
FROM deps AS builder
COPY . .
RUN DATABASE_URL="postgresql://x:x@localhost/x" pnpm exec prisma generate --schema=prisma/schema.prisma
RUN pnpm --filter @ectd/api build

# ── Production image ─────────────────────────────────────────────────────────
FROM node:22-alpine AS production
RUN apk add --no-cache libc6-compat dumb-init
WORKDIR /app

# Non-root user — spec §43 (security hardening)
RUN addgroup --system --gid 1001 ectd && adduser --system --uid 1001 ectd
USER ectd

COPY --from=builder --chown=ectd:ectd /app/node_modules ./node_modules
COPY --from=builder --chown=ectd:ectd /app/apps/api/dist ./dist
COPY --from=builder --chown=ectd:ectd /app/prisma ./prisma

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# dumb-init handles SIGTERM properly so NestJS can gracefully shut down
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main"]
