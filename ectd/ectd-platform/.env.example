# ──────────────────────────────────────────────
# ProgrammoCeuticals eCTD Platform — Environment
# ──────────────────────────────────────────────
# Copy to .env and fill in values.
# Never commit .env to version control.

# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://ectd_user:changeme@localhost:5432/ectd_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_PROVIDER=local
STORAGE_ROOT=/tmp/ectd-storage

# Regulatory packages root
REGULATORY_PACKAGE_ROOT=./regulatory/packages

# Sender identity — REQUIRED for XML generation and publishing
# Set to your organization's ICH-assigned OID.
# Do NOT invent or guess this value.
# Publication and XML generation are BLOCKED until this is set.
ECTD_SENDER_OID=
ECTD_SENDER_NAME=

# Malware scanning — REQUIRED for production document upload
# Set to your ClamAV daemon URL (e.g. tcp://clamav:3310)
# Document upload is BLOCKED until this is configured.
ECTD_CLAMAV_URL=

# Logging
LOG_LEVEL=info
