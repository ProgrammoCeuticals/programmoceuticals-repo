{
  "name": "ectd-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --testPathPattern=tests/unit",
    "test:integration": "jest --config jest.config.ts --testPathPattern=tests/integration",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "db:generate": "pnpm exec prisma generate --schema=prisma/schema.prisma",
    "db:migrate:dev": "pnpm exec prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy --schema=prisma/schema.prisma",
    "db:validate": "pnpm exec prisma validate --schema=prisma/schema.prisma",
    "db:format": "pnpm exec prisma format --schema=prisma/schema.prisma",
    "db:seed": "pnpm exec ts-node prisma/seed/index.ts"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.9.0",
    "@types/uuid": "10.0.0",
    "eslint": "9.16.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "prisma": "5.22.0",
    "ts-jest": "29.2.5",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@nestjs/common": "10.4.7",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  }
}
