{
  "name": "rims",
  "private": true,
  "version": "0.1.0",
  "description": "RIMS — Regulatory Information Management System",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "5.19.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "prisma": "5.19.1",
    "ts-node": "10.9.2",
    "turbo": "2.1.3",
    "typescript": "5.7.2"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {}
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.json --transpile-only prisma/seed.ts"
  }
}
