enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR

  @@map("integration_status")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING

  @@map("webhook_delivery_status")
}

enum NotificationChannel {
  IN_APP
  EMAIL

  @@map("notification_channel")
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED

  @@map("notification_status")
}

// ─── Usage Metering ───────────────────────────────────────────────────────────

model UsageRecord {
