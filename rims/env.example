# ─────────────────────────────────────────────────────────────────────────────
# RIMS Environment Variables
# Copy this file to .env and fill in all required (*) values before running.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────

# * PostgreSQL connection string used by the API at runtime (app_role).
#   Uses RLS — set_tenant_context() is called before every query.
DATABASE_URL=postgresql://rims_dev:rims_dev_secret@localhost:5432/rims_dev

# * PostgreSQL connection string used for Prisma migrations (migration_role, BYPASSRLS).
#   Keep this separate from DATABASE_URL to avoid running migrations as app_role.
DATABASE_MIGRATION_URL=postgresql://rims_dev:rims_dev_secret@localhost:5432/rims_dev

# ─── Redis ────────────────────────────────────────────────────────────────────

# * Redis connection URL used by BullMQ worker and session cache.
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────

# * Secret key for signing short-lived access tokens. Use a random 64-char hex string.
JWT_ACCESS_SECRET=change_me_access_secret

# * Secret key for signing long-lived refresh tokens. Use a different random 64-char hex string.
JWT_REFRESH_SECRET=change_me_refresh_secret

# Access token TTL (default 15 minutes). Supports ms/zeit format: 15m, 1h, 1d.
JWT_ACCESS_EXPIRY=15m

# Refresh token TTL (default 7 days).
JWT_REFRESH_EXPIRY=7d

# ─── Server ───────────────────────────────────────────────────────────────────

# Application environment: development | test | production
NODE_ENV=development

# Port the NestJS API listens on.
PORT=3000

# ─── Frontend ─────────────────────────────────────────────────────────────────

# Base URL of the API, as seen from the browser. Used by @rims/api-client.
VITE_API_URL=http://localhost:3000/api/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────

# * Allowed origin(s) for CORS. In production use the exact SPA domain.
#   Multiple origins can be comma-separated: https://app.rims.io,https://admin.rims.io
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Time window in seconds for the rate-limit throttle bucket.
THROTTLE_TTL=60

# Maximum requests allowed per THROTTLE_TTL window per IP.
THROTTLE_LIMIT=100

# ─── Email / SMTP ─────────────────────────────────────────────────────────────

# * SMTP server hostname (e.g. smtp.sendgrid.net, smtp.mailgun.org).
SMTP_HOST=smtp.example.com

# * SMTP server port (usually 587 for TLS, 465 for SSL, 25 for plain).
SMTP_PORT=587

# * SMTP authentication username.
SMTP_USER=apikey

# * SMTP authentication password or API key.
SMTP_PASS=change_me_smtp_password

# * From address shown on outbound emails.
SMTP_FROM=noreply@rims.io

# ─── Seeding ──────────────────────────────────────────────────────────────────

# Set to true to seed demo tenants, users, and data when running prisma:seed.
SEED_DEMO=true
