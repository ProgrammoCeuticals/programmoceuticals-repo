{
  "name": "@rims/api",
  "version": "0.1.0",
  "private": true,
  "description": "RIMS NestJS REST API",
  "scripts": {
    "build": "nest build",
    "dev": "../../node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "start": "../../node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.7",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.7",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.7",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.2.1",
    "@aws-sdk/client-s3": "3.693.0",
    "@aws-sdk/s3-request-presigner": "3.693.0",
    "@prisma/client": "5.22.0",
    "@rims/shared-types": "workspace:*",
    "@rims/validation": "workspace:*",
    "argon2": "0.41.1",
    "bullmq": "5.13.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "joi": "17.13.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.4.7",
    "@rims/config": "workspace:*",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.9.0",
    "@types/passport-jwt": "4.0.1",
    "@types/uuid": "10.0.0",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "ts-node ../../prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@rims/shared-types(.*)$": "<rootDir>/../../packages/shared-types/src$1",
      "^@rims/validation(.*)$": "<rootDir>/../../packages/validation/src$1"
    }
  }
}
