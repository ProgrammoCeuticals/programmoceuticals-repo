    "type-check": "tsc --project tsconfig.json --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "nodemailer": "6.9.16",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.7",
