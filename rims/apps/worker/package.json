{
  "name": "@rims/worker",
  "version": "0.1.0",
  "private": true,
  "description": "RIMS BullMQ background worker",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "echo 'Worker requires Redis — skipping in dev. Install Redis to enable background jobs.' && exit 0",
