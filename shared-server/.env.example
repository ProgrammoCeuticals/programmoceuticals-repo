PORT=4000

# DRR — PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/office_mail_tracking?schema=public"
JWT_SECRET="change-this-secret"

# DRR clients allowed origins (comma-separated)
DRR_CLIENT_ORIGIN="http://localhost:4200"

# Samples — MongoDB
MONGO_URI="mongodb+srv://user:pass@cluster0.mongodb.net/samples_app"
ADMIN_PASSWORD="admin123"
ADMIN_TOKEN_SECRET="change-this-token-secret"
ADMIN_TOKEN_TTL_HOURS=12

# Samples client allowed origin
SAMPLES_CLIENT_ORIGIN="http://localhost:3000"
