PORT=5001
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/pharmapool

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (Gmail recommended — use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where admin notifications go
ADMIN_EMAIL=conference.pharmapool@gmail.com

# Admin
ADMIN_PASSWORD=changeme
ADMIN_TOKEN=pharmapool-admin-secret-token
